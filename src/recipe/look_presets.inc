pub fn find_look_preset(name: &str) -> Option<&'static LookPresetSpec> {
    let key = name.trim();
    LOOK_PRESETS
        .iter()
        .find(|p| p.id.eq_ignore_ascii_case(key) || p.alias.eq_ignore_ascii_case(key))
}
