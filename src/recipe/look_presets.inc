// Single source of truth for the 5 built-in look presets, shared between
// `omastudio-engine` (`src/recipe/mod.rs`) and `omastudio-app` (`app/src/host.rs`).

#[derive(Debug, Clone, Copy)]
pub struct LookPresetSpec {
    pub id: &'static str,
    pub alias: &'static str,
    pub wb_temperature: Option<f32>,
    pub wb_tint: Option<f32>,
    pub contrast: f32,
    pub highlights: f32,
    pub shadows: f32,
    pub whites: f32,
    pub blacks: f32,
    pub texture: f32,
    pub clarity: f32,
    pub vibrance: f32,
    pub saturation: f32,
    pub sharpness: f32,
    pub vignette: f32,
    pub lift: [f32; 3],
    pub lift_luma: f32,
    pub gain: [f32; 3],
    pub gain_luma: f32,
    pub hsl_hue: [f32; 8],
    pub hsl_sat: [f32; 8],
    pub hsl_lum: [f32; 8],
}

