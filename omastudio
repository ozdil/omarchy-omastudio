#!/bin/bash -p
set -euo pipefail

# Immediate rejection of loader injection
if [ -n "${LD_PRELOAD:-}" ] || [ -n "${LD_LIBRARY_PATH:-}" ]; then
    echo "Security Error: Prohibited loader control variable detected" >&2
    exit 1
fi

# Re-exec through fixed trusted shell under sanitized environment (/usr/bin/env -i)
if [ "${OMASTUDIO_SECURE_ENV:-0}" != "1" ]; then
    # Desktop-session variables (D-Bus, cursor theme, HiDPI scaling) are forwarded only
    # when set; dropping them gave the UI the wrong cursor and scale factor.
    SESSION_ENV=()
    for var in XDG_CURRENT_DESKTOP XDG_SESSION_TYPE DBUS_SESSION_BUS_ADDRESS HYPRLAND_INSTANCE_SIGNATURE \
               XCURSOR_THEME XCURSOR_SIZE QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME QT_SCALE_FACTOR QT_SCREEN_SCALE_FACTORS \
               QT_AUTO_SCREEN_SCALE_FACTOR XDG_ACTIVATION_TOKEN DESKTOP_STARTUP_ID; do
        if [ -n "${!var:-}" ]; then
            SESSION_ENV+=("${var}=${!var}")
        fi
    done
    exec /usr/bin/env -i \
        PATH="/usr/bin:/bin:${HOME}/.local/bin:${HOME}/.cargo/bin" \
        HOME="${HOME}" \
        USER="${USER:-$(/usr/bin/id -un 2>/dev/null || echo "user")}" \
        LANG="${LANG:-C.UTF-8}" \
        LC_ALL="${LC_ALL:-C.UTF-8}" \
        DISPLAY="${DISPLAY:-}" \
        WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
        XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(/usr/bin/id -u 2>/dev/null || echo 1000)}" \
        XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" \
        XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}" \
        XDG_CACHE_HOME="${XDG_CACHE_HOME:-${HOME}/.cache}" \
        "${SESSION_ENV[@]}" \
        OMASTUDIO_SECURE_ENV=1 \
        /bin/bash -p "$0" "$@"
fi

# Reject unexpected build and loader controls before building or launching
for var in LD_PRELOAD LD_LIBRARY_PATH RUSTC_WRAPPER CARGO_BUILD_RUSTC_WRAPPER RUSTFLAGS CARGO_HOME BASH_ENV ENV; do
    if [ -n "${!var+x}" ]; then
        echo "Security Error: Prohibited build/loader control variable detected: ${var}" >&2
        exit 1
    fi
done

DIR="$(cd "$(/usr/bin/dirname "$(/usr/bin/realpath "${BASH_SOURCE[0]}")")" && /usr/bin/pwd)"
BIN="${DIR}/omastudio-engine"
if [[ ! -x "${BIN}" ]]; then
    BIN="${HOME}/.local/bin/omastudio-engine"
fi

# Resolve trusted cargo binary
CARGO_BIN=""
if [[ -x /usr/bin/cargo ]]; then
    CARGO_BIN="/usr/bin/cargo"
elif [[ -x "${HOME}/.cargo/bin/cargo" ]]; then
    CARGO_BIN="${HOME}/.cargo/bin/cargo"
fi

# Ensure binary exists or build it using trusted absolute tools
if [[ ! -x "${BIN}" ]]; then
    if [[ -f "${DIR}/target/release/omastudio-engine" ]]; then
        /usr/bin/install -d -m 755 "${HOME}/.local/bin"
        /usr/bin/install -m 755 "${DIR}/target/release/omastudio-engine" "${BIN}"
    elif [[ -n "${CARGO_BIN}" && -f "${DIR}/Cargo.toml" ]]; then
        echo "Building omastudio-engine from source..."
        (cd "${DIR}" && "${CARGO_BIN}" build --release --locked && /usr/bin/install -d -m 755 "${HOME}/.local/bin" && /usr/bin/install -m 755 "${DIR}/target/release/omastudio-engine" "${BIN}") || true
    fi
fi

# Locate the application next to this script, in ~/.local/bin or in /usr/bin
APP="${DIR}/omastudio-app"
if [[ ! -x "${APP}" ]]; then
    APP="${HOME}/.local/bin/omastudio-app"
fi
if [[ ! -x "${APP}" ]]; then
    APP="/usr/bin/omastudio-app"
fi
# Tell the application which engine binary was resolved
export OMASTUDIO_ENGINE="${BIN}"

case "${1:-}" in
    --cli)
        shift
        exec "${BIN}" "$@"
        ;;
    ipc)
        # `omastudio ipc [call] <method> [args...]`: talk to the running window
        shift
        exec "${APP}" ipc "$@"
        ;;
    --help|-h|help)
        exec "${BIN}" help
        ;;
    --version|-v|version)
        exec "${BIN}" version
        ;;
    --status|status)
        exec "${BIN}" status
        ;;
    theme)
        shift
        case "${1:-}" in
            reload) exec "${APP}" ipc reloadTheme ;;
            get) exec "${APP}" ipc getTheme ;;
            *) exec "${BIN}" theme "$@" ;;
        esac
        ;;
    skill)
        # `omastudio skill [dir]`: installs the agent skill (default ~/.claude/skills)
        TARGET="${2:-${HOME}/.claude/skills}"
        for SRC in "${DIR}/skill/omastudio/SKILL.md" "${HOME}/.local/share/omastudio/skill/omastudio/SKILL.md" \
                   "/usr/share/omastudio/skill/omastudio/SKILL.md"; do
            if [[ -f "${SRC}" ]]; then
                /usr/bin/install -Dm644 "${SRC}" "${TARGET}/omastudio/SKILL.md"
                echo "Installed ${TARGET}/omastudio/SKILL.md"
                exit 0
            fi
        done
        echo "SKILL.md not found" >&2
        exit 1
        ;;
    inspect|render|export|ai-auto|ai-social|ai-jev|icc|scan|catalog|dag|daemon|gpu|npu|ai-mask|mcp|ai|xmp|fuji-*)
        exec "${BIN}" "$@"
        ;;
esac

if [[ ! -x "${APP}" ]]; then
    echo "omastudio-app is not installed. Falling back to the omastudio-engine CLI." >&2
    exec "${BIN}" help
fi
# Opens the window, or hands the photo to the one already running
exec "${APP}" "$@"
