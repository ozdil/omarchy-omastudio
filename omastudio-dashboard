#!/usr/bin/env bash
set -euo pipefail

# Show or hide the running window; start it when none is running
if [[ "${1:-}" != "--cli" ]] && command -v omastudio-app >/dev/null 2>&1; then
    if omastudio-app ipc toggle >/dev/null 2>&1; then
        exit 0
    fi
fi

DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
exec "${DIR}/omastudio" "$@"
